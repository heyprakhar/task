<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                    disableAnsi="false"
                    noConsoleNoAnsi="false"
                    pattern="%style{%d{yyyy-MM-dd HH:mm:ss}}{green} %style{[%X{traceId}]}{yellow} %style{[%t]}{blue} %highlight{%-5level} %style{[%X{method} %X{path}]}{magenta} %style{[%c{1}.%M]}{blue} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>

</Configuration>